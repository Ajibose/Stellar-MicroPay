PORT=4000
NODE_ENV=development

# Required — validated at startup (see src/config/validateEnv.js)
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# JWT signing secret for SEP-0010 session tokens.
# REQUIRED in production — the app refuses to start with the built-in default.
# Generate a strong value, e.g.  openssl rand -hex 32
JWT_SECRET=

# Server keypair used to sign SEP-0010 challenge transactions.
# If unset, an ephemeral keypair is generated per cold start (tokens won't
# survive restarts). Set a stable secret (S...) in production.
SERVER_PRIVATE_KEY=

# Stellar Federation (SEP-0001/SEP-0002)
FEDERATION_DOMAIN=stellarmicropay.io
FEDERATION_DOMAINS=stellarmicropay.io,stellarmicropay.com
# Optional override. Defaults to https://<FEDERATION_DOMAIN>/federation.
FEDERATION_SERVER_URL=

# Sentry error tracking (#293)
SENTRY_DSN=

# ─── Analytics Cache ──────────────────────────────────────────────────────
# Redis URL for the analytics cache. Leave unset to use the in-memory fallback
# (suitable for single-instance dev servers). In production, point this at a
# Redis service so cached analytics survive restarts and are shared across
# instances (#1072).
REDIS_URL=redis://localhost:6379

# Cache TTL in milliseconds (default: 300000 = 5 minutes).
ANALYTICS_CACHE_TTL_MS=300000
